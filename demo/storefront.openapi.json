      "get": {
        "summary": "List products",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "productName",
                      "price"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "productName": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "subcategory": {
                        "type": "string"
                      },
                      "brand": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number",
                        "minimum": 1
                      },
                      "stock": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "rating": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "inStock": {
                        "type": "boolean"
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
