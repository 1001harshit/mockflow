# --- API ---
PORT=4000
NODE_ENV=development

# --- Database (a single SQLite file; no server to run) ---
DATABASE_URL="file:./mockflow.db"


# --- Auth ---
# Required in production: the API refuses to start with NODE_ENV=production
# while these are unset or still the change-me placeholders.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- AI (Phase 6) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_MODEL_BULK="gpt-4o-mini"

# --- Dashboard ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
